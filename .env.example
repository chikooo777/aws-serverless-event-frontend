# AWS Serverless Backend Configuration
# 1. Lambda Function URL (Enable CORS and AuthType=AWS_IAM or NONE)
VITE_LAMBDA_FUNCTION_URL=https://your-lambda-id.lambda-url.us-east-1.on.aws/

# 2. AWS Cognito Configuration (for AWS Amplify / Amazon Cognito integration)
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_exampleId
VITE_COGNITO_CLIENT_ID=exampleClientId123456
